# Site URL (used in sitemap, robots, feed, metadata)
SITE_URL=https://runbyagents.usectl.com

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/runbyagent

# Database schema (default: public)
# Use a custom schema if sharing the database with other apps
DB_SCHEMA=public

# Admin API (used by the agent)
ADMIN_KEY=your-secret-admin-key

# Admin token for abuse monitoring endpoints
ADMIN_TOKEN=your-admin-token

# Salt for IP hashing (falls back to ADMIN_KEY if not set)
HASH_SALT=your-random-salt-for-ip-hashing

# Cron routes (for scheduled tasks)
CRON_SECRET=your-secret-cron-key

# Stripe (for revenue tracking)
STRIPE_SECRET_KEY=sk_test_...

# Painboard URL (for metrics)
PAINBOARD_URL=https://painboard.example.com

# S3 storage (auto-injected by usectl, do not set manually)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
