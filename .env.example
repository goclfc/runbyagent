# Database
DATABASE_URL=postgresql://user:password@localhost:5432/runbyagent

# Admin API (used by the agent)
ADMIN_KEY=your-secret-admin-key

# Cron routes (for scheduled tasks)
CRON_SECRET=your-secret-cron-key

# Stripe (for revenue tracking)
STRIPE_SECRET_KEY=sk_test_...

# Painboard URL (for metrics)
PAINBOARD_URL=https://painboard.example.com

# S3 storage (auto-injected by usectl, do not set manually)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
